// src/Exercise3.js
import React from "react";
import "./Exercise.css";

class Exercise extends React.Component {
  render() {
    const style_header = {
      color: "white",
      backgroundColor: "DodgerBlue",
      padding: "10px",
      fontFamily: "Arial",
    };

    return (
      <div>
        {/* Part I & II */}
        <h1 style={style_header}>Styled Header</h1>
        <p className="para">
          Styled paragraph with external CSS file.
        </p>
        <a href="https://react.dev">Learn React</a>
        <form>
          <input type="text" placeholder="Enter text" />
          <button type="submit">Submit</button>
        </form>
        <img
          src="https://picsum.photos/200"
          alt="Random"
          style={{ width: "200px" }}
        />
        <ul>
          <li>Item 1</li>
          <li>Item 2</li>
          <li>Item 3</li>
        </ul>
      </div>
    );
  }
}

export default Exercise;


