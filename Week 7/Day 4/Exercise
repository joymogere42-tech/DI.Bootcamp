// src/UserFavoriteAnimals.js
import React from "react";

class UserFavoriteAnimals extends React.Component {
  render() {
    return (
      <ul>
        {this.props.favAnimals.map((animal, index) => (
          <li key={index}>{animal}</li>
        ))}
      </ul>
    );
  }
}

export default UserFavoriteAnimals;


